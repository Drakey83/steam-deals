{
  "name": "steam-deals",
  "productName": "Steam Deals",
  "version": "1.15.2",
  "description": "Find the best Steam discounts on games you don't already own.",
  "author": "Reid Carlisle",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint .",
    "check:imports": "node scripts/check-imports.mjs",
    "check": "npm run lint && npm run check:imports && npm test",
    "test:relay": "node scripts/test-relay.mjs https://steamdeal.vercel.app",
    "selftest": "node src/main/steam.js --selftest",
    "icon": "python scripts/make-icon.py",
    "pack": "electron-builder --dir",
    "dist": "npm run check && electron-builder --win --x64",
    "web:build": "node scripts/build-web.mjs",
    "web:deploy": "npm run check && node scripts/build-web.mjs && cd web && vercel deploy --prod --yes",
    "web:local": "node scripts/serve-web.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  },
  "build": {
    "appId": "com.steamdeals.app",
    "productName": "Steam Deals",
    "copyright": "Not affiliated with Valve Corporation. Steam is a trademark of Valve Corporation.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ],
    "protocols": [
      {
        "name": "Steam Deals",
        "schemes": [
          "steamdeals"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Steam-Deals-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Steam Deals",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Drakey83",
        "repo": "steam-deals",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
